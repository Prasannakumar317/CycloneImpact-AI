# TRICODEX — CYCLONESHIELD AI Environment Variables (Template)
# NOTE: Do NOT commit your actual .env file or real secrets to version control.
# Copy this file to .env and insert your real keys if available.

# Application Environment Mode (demo | staging | production)
VITE_APP_MODE=demo

# Google Gemini API Key for AI Action Planner & Public Advisories
# Supported Models: gemini-3.7-flash (primary), gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
# If left empty, the application runs seamlessly in safe offline fallback mock mode.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Earth Engine (GEE) Satellite Integration (Optional)
# SECURITY & ARCHITECTURE NOTICE:
# Google Earth Engine uses server-side Python/Node APIs with Service Account Private Keys.
# To prevent exposing private credentials in client-side code, real Earth Engine computations 
# are executed on a secure backend which generates an ephemeral XYZ Tile URL or MapID.
# Provide a public or authenticated tile endpoint if connecting to a real Earth Engine instance:
VITE_GEE_PROJECT_ID=your_gee_project_id_here
VITE_GEE_MAP_ID=your_gee_map_id_here
VITE_GEE_TILE_URL=https://earthengine.googleapis.com/v1/projects/{project}/maps/{mapId}/tiles/{z}/{x}/{y}

# Future Map Connectors (Optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
